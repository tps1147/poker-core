  "cues": [
    {
      "start": 0,
      "end": 3.2083333333333335,
      "text": "Bluffing is not what you do because you missed."
    },
    {
      "start": 3.2083333333333335,
      "end": 10.041666666666666,
      "text": "Bluffing is what you do when your line credibly represents value and your opponent can fold better hands."
    },
    {
      "start": 10.041666666666666,
      "end": 12.708333333333334,
      "text": "Ask two questions before you fire:"
    },
    {
      "start": 12.708333333333334,
      "end": 17.458333333333332,
      "text": "What strong hands am I representing, and what better hands can they release?"
    },
    {
      "start": 17.458333333333332,
      "end": 26.416666666666668,
      "text": "Here, your ace-jack has poor showdown value, but your line can represent strong king-x, ace-king, ace-queen, and overpairs."
    },
    {
      "start": 26.416666666666668,
      "end": 29.666666666666668,
      "text": "Your ace also blocks some of the strongest calls."
    },
    {
      "start": 29.666666666666668,
      "end": 33.291666666666664,
      "text": "Villain checks a capped river with many one-pair hands."
    }
  ],
